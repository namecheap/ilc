{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "sourceMap": true,
        "strict": true,
        "typeRoots": ["./node_modules/@types"],
        "types": ["codeceptjs", "node", "./typings/steps"],
        "esModuleInterop": true,
        "declaration": true,
        "skipLibCheck": true,
        "moduleResolution": "Bundler"
    },
    "exclude": ["node_modules"]
}
