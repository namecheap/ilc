{
    "name": "registry",
    "version": "1.0.0",
    "description": "",
    "main": "build/index.js",
    "scripts": {
        "compile": "tsc -p tsconfig.app.json --incremental && copyfiles \"server/seeds/data/**/*\" build",
        "dev": "rimraf build && nodemon -e ts,json5 --exec \"tsc -p tsconfig.app.json --incremental && pnpm start | pino-pretty\" ",
        "build": "pnpm compile && cd ./client && pnpm build",
        "start": "dotenv -- node -r source-map-support/register ./build/server/index.js",
        "start-docker": "pnpm migrate:compiled && pnpm start",
        "knex": "knex",
        "migrate": "pnpm compile && dotenv -- pnpm migrate:compiled",
        "migrate:compiled": "knex --knexfile build/config/knexfile.js migrate:latest",
        "migrate:make": "cross-env NODE_OPTIONS=--import=tsx knex --knexfile config/knexfile.ts migrate:make --migrations-directory ../server/migrations",
        "migrate:rollback": "pnpm compile && dotenv -- pnpm migrate:rollback:compiled",
        "migrate:rollback:compiled": "knex --knexfile build/config/knexfile.js migrate:rollback",
        "seed": "pnpm compile && dotenv -- pnpm seed:compiled",
        "seed:compiled": "knex --knexfile build/config/knexfile.js seed:run",
        "seed:make": "cross-env NODE_OPTIONS=--import=tsx knex --knexfile config/knexfile.ts seed:make -x ts",
        "test": "cross-env-shell NODE_ENV=test \"pnpm reset && tsc -p tsconfig.spec.json && mocha\" ",
        "test:ci": "pnpm migrate && tsc -p tsconfig.spec.json && cross-env NODE_ENV=test dotenv -- nyc mocha --forbid-only",
        "reset": "dotenv bash ./scripts/reset.sh && pnpm migrate",
        "assetsdiscovery": "cross-env NODE_ENV=production INTERVAL=2000 node -r source-map-support/register ./build/server/runnerAssetsDiscovery.js",
        "assetsdiscovery:dev": "nodemon -e ts,json5 --exec \"tsc -p tsconfig.app.json --incremental && dotenv -- pnpm assetsdiscovery | pino-pretty\" "
    },
    "author": "",
    "license": "Apache-2.0",
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/bcrypt": "^6.0.0",
        "@types/chai": "^5.2.3",
        "@types/chai-as-promised": "^8.0.2",
        "@types/deep-equal": "^1.0.4",
        "@types/escape-html": "^1.0.4",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mocha": "^10.0.10",
        "@types/newrelic": "^9.14.8",
        "@types/node": "^22.20.5",
        "@types/passport": "^1.0.17",
        "@types/passport-http-bearer": "^1.0.42",
        "@types/passport-local": "^1.0.38",
        "@types/serve-static": "^2.2.0",
        "@types/sinon": "^22.0.0",
        "@types/supertest": "^7.2.1",
        "chai": "6.3.0",
        "chai-as-promised": "^8.0.2",
        "copyfiles": "^2.4.1",
        "cross-env": "10.1.0",
        "jsonwebtoken": "^9.0.3",
        "mocha": "^12.0.3",
        "nock": "^15.0.1",
        "nodemon": "^3.1.14",
        "nyc": "^18.0.0",
        "oauth2-mock-server": "^9.2.0",
        "pino-pretty": "^13.2.0",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@hapi/address": "^5.1.1",
        "@namecheap/error-extender": "^2.2.1",
        "@newrelic/native-metrics": "^13.1.0",
        "axios": "^1.20.0",
        "bcrypt": "^6.0.0",
        "config": "^5.0.1",
        "connect-session-knex": "^5.0.0",
        "deep-equal": "^2.2.3",
        "dotenv-cli": "^11.0.0",
        "escape-html": "^1.0.3",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "http-shutdown": "^1.2.2",
        "ilc-plugins-sdk": "^3.1.0",
        "knex": "^3.3.0",
        "newrelic": "^14.7.0",
        "node-html-parser": "^9.0.4",
        "openid-client": "^6.8.8",
        "passport": "^0.7.0",
        "passport-http-bearer": "^1.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.23.1",
        "serve-static": "^2.2.1",
        "source-map-support": "^0.5.21",
        "url-join": "^5.0.0",
        "uuid": "^14.0.2",
        "zod": "^4.6.5"
    },
    "engines": {
        "node": ">=22"
    }
}
